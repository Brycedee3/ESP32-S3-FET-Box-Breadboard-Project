  tft.setCursor(10, 150);  tft.print("Src:");
  tft.setCursor(10, 190);  tft.print("FET2:");

  // Temperature lives at the bottom-right of the FET2 row (fully visible through
  // the panel cutout). Small label above the value.
  tft.setTextSize(1);
  tft.setCursor(TEMP_LABEL_X, TEMP_LABEL_Y); tft.print("TEMP");
}

void updateScreenValues() {
  if (overTemp) return;
  tft.setTextSize(2);
  tft.setTextColor(TFT_GREEN, TFT_BLACK);

  tft.setCursor(80, 60);  tft.print("        ");
  tft.setCursor(80, 60);  tft.print(dutyCycle); tft.print(" %");

  tft.setCursor(80, 100); tft.print("            ");
  tft.setCursor(80, 100); tft.print(frequency); tft.print(" Hz");

  tft.setCursor(80, 150); tft.print("              ");
  tft.setCursor(80, 150);
  if (extSource)       tft.print(extNoSignal ? "EXT: NO SIG" : "EXTERNAL");
  else if (dSourceExt) tft.print("INT, D=BNC");
  else                 tft.print("INTERNAL");

  tft.setCursor(80, 190); tft.print("          ");   // 10 chars: longest mode name
  tft.setCursor(80, 190);
  // Legacy front-panel names (DD00003 sec. 6.2)
  if (currentMode == MODE_ALT)        tft.print("COMPL (q')");
  else if (currentMode == MODE_ALTQ)  tft.print("ALTERNATE");
  else                                tft.print("COPY (q)");
}

void updateFreqScaleIndicator() {
  if (overTemp) return;
  if (screenNeedsFreqModeUpdate) {
    tft.setTextSize(1);
    tft.setCursor(80, 120); 
    tft.print("             "); 
    tft.setCursor(80, 120);
    
    if (freqFineMode) {
      tft.setTextColor(TFT_CYAN, TFT_BLACK);
      tft.print("[FINE SCALE]");
    } else {
      tft.setTextColor(TFT_ORANGE, TFT_BLACK);
      tft.print("[COARSE SCALE]");
    }
    screenNeedsFreqModeUpdate = false;
  }
}

void initTempSensor() {
  sensors.begin();
  sensors.setWaitForConversion(false);
  sensors.requestTemperatures();
}

void pollTemperature() {
  float t = sensors.getTempCByIndex(0);
  if (t == DEVICE_DISCONNECTED_C) tempOk = false;
  else { tempOk = true; tempC = t; }
  sensors.requestTemperatures();
}

void updateTempOnScreen() {
  if (overTemp) { updateOverTempReading(); return; }
  // Right-aligned on the FET2 row, inside the visible area of the screen.
  tft.setTextSize(2);
  tft.setTextColor(TFT_GREEN, TFT_BLACK);
  tft.setCursor(TEMP_VALUE_X0, TEMP_VALUE_Y);
  tft.print("       ");                                   // clear 7 chars (84 px)

  String txt;
  if (!tempOk) {
    txt = "ERR";
    tft.setTextColor(TFT_RED, TFT_BLACK);
  } else {
    txt = String(tempC, 1) + "C";                       // e.g. "23.9C", "105.2C"
    tft.setTextColor(TFT_GREEN, TFT_BLACK);
  }
  int x = TEMP_RIGHT_EDGE_X - (int)txt.length() * 12;   // size-2 glyph = 12 px wide
  tft.setCursor(x, TEMP_VALUE_Y);
  tft.print(txt);
}

// ---------------- OVER-TEMPERATURE ----------------
void redrawMainScreen() {
  tft.fillScreen(TFT_BLACK);
  drawInterface();
  drawStatusLight();
  updateScreenValues();
  screenNeedsFreqModeUpdate = true;
  updateFreqScaleIndicator();
  updateTempOnScreen();
}

void printCentered(const char *txt, int y, int size, uint16_t fg, uint16_t bg) {
  tft.setTextSize(size);
  tft.setTextColor(fg, bg);
  int w = strlen(txt) * 6 * size;
  tft.setCursor((320 - w) / 2, y);
  tft.print(txt);
}

// Pop-up alert over the normal screen.
void drawOverTempScreen() {
  tft.fillScreen(TFT_BLACK);
  tft.fillRoundRect(16, 30, 288, 180, 12, TFT_RED);
  tft.drawRoundRect(16, 30, 288, 180, 12, TFT_WHITE);
  printCentered("OVER TEMP", 48, 3, TFT_WHITE, TFT_RED);
  printCentered("Outputs OFF - cooling", 88, 2, TFT_WHITE, TFT_RED);
  char buf[40];
  snprintf(buf, sizeof(buf), "Resumes below %.0f C", (double)OT_CLEAR_C);
  printCentered(buf, 182, 1, TFT_WHITE, TFT_RED);
  updateOverTempReading();
}

void updateOverTempReading() {
  char buf[24];
  if (tempOk) snprintf(buf, sizeof(buf), "  %.1f C  ", (double)tempC);
  else        snprintf(buf, sizeof(buf), " SENSOR ERR ");
  printCentered(buf, 128, 3, TFT_YELLOW, TFT_RED);
}

void enterOverTemp() {
  overTemp = true;
  otBelowCount = 0;
  pwmTeardown();                     // FET A/B and the q(t) BNC output forced off
  drawOverTempScreen();
  broadcast("THERMAL:TRIP");
  broadcast("INFO:over_temperature=" + String(tempC, 1) + "C; outputs off until below " + String(OT_CLEAR_C, 0) + "C");
}

void exitOverTemp() {
  overTemp = false;
  otAboveCount = 0;
  redrawMainScreen();
  applyPwm();                        // resume with the current settings
  broadcast("THERMAL:OK");
  broadcast("DUTY:" + String(dutyCycle));
  broadcast("FREQ:" + String(frequency));
}

// Called once per temperature reading.
void checkThermal() {
  if (!tempOk) { otAboveCount = 0; otBelowCount = 0; return; }   // no decision on a bad read
  if (!overTemp) {
    if (tempC > OT_TRIP_C) { if (++otAboveCount >= OT_CONFIRM_READS) enterOverTemp(); }
    else otAboveCount = 0;
  } else {
    if (tempC < OT_CLEAR_C) { if (++otBelowCount >= OT_CONFIRM_READS) exitOverTemp(); }
    else otBelowCount = 0;
  }
}

// ---------------- MODE SWITCH + MODE CHANGES ----------------
bool modeSwActive(int pin) {
  int v = digitalRead(pin);
  return MODE_SW_ACTIVE_LOW ? (v == LOW) : (v == HIGH);
}

// 0 = up, 1 = middle, 2 = down, -1 = both contacts active (wiring fault)
int readModeSwitchRaw() {
  bool up = modeSwActive(MODE_SW_UP_PIN);
  bool dn = modeSwActive(MODE_SW_DOWN_PIN);
  if (up && dn) return -1;
  if (up)       return 0;
  if (dn)       return 2;
  return 1;
}

FetMode modeFromSwitch(int pos) {
  if (pos == 0) return MODE_COPY;   // up
  if (pos == 2) return MODE_ALT;    // down: complement with dead time
  return MODE_ALTQ;                 // middle: alternate
}

const char *modeToken(FetMode m) {
  if (m == MODE_ALT)  return "ALT";
  if (m == MODE_ALTQ) return "ALTQ";
  return "COPY";
}

// Send one status line to the USB app and, if connected, the BLE app.
void broadcast(const String &msg) {
  Serial.println(msg);
  if (deviceConnected) {
    String bleMsg = msg + "\n";
    pTxCharacteristic->setValue(bleMsg.c_str());
    pTxCharacteristic->notify();
  }
}

// Single path for every mode change (panel switch or app command), so the
// PWM, the TFT and both apps always agree.
void setFetMode(FetMode m) {
  currentMode = m;
  applyPwm();
  updateScreenValues();
  broadcast(String("FET2:") + modeToken(currentMode));
  broadcast("DUTY:" + String(dutyCycle));   // may have been clamped for Alternate
}

// Panel switch wins whenever it MOVES. An app can still pick a mode
// afterwards; it holds until the switch is moved again.
void checkModeSwitch() {
  int raw = readModeSwitchRaw();
  unsigned long now = millis();
  if (raw != modeSwLastRaw) {          // reading changed: restart debounce timer
    modeSwLastRaw = raw;
    modeSwChangedAt = now;
    return;
  }
  if (raw < 0) return;                 // both contacts active: ignore
  if (raw != modeSwStable && now - modeSwChangedAt >= MODE_SW_DEBOUNCE_MS) {
    modeSwStable = raw;
    FetMode m = modeFromSwitch(raw);
    if (m != currentMode) setFetMode(m);
  }
}

// ---------------- SOURCE SWITCH ----------------
// 1 = EXTERNAL, 0 = INTERNAL
int readSourceSwitchRaw() {
  bool low = (digitalRead(SRC_SW_PIN) == LOW);
  return (low == (SRC_SW_EXT_WHEN_LOW == 1)) ? 1 : 0;
}

// Single path for every source change (panel switch or app), so the screen
// and both apps always agree. NOTE: the external q(t) input itself is not
// implemented yet; this only records and reports the selection.
void setSource(bool ext) {
  // Any int/ext change: force PWM-A/B low, reconfigure IO17/IO18 and the timer
  // source, then release.
  pwmTeardown();                       // outputs low, IO17 released to high-Z
  extSource = ext;
  outputsLatchedOff = false;
  if (ext) {
    extNoSignal = true;                // stay off until a valid external q(t) is measured
    extAppliedDuty = -100;
    if (!startCapture()) broadcast("INFO:ext=CAPTURE_ERROR");
  } else {
    stopCapture();
    extNoSignal = false;
    applyPwm();                        // rebuild with the q(t) reference on IO17
  }
  updateScreenValues();
  broadcast(ext ? "SOURCE:EXT" : "SOURCE:INT");
  if (ext) broadcast("INFO:ext=WAITING_FOR_SIGNAL");
}

// Same rule as the mode switch: the panel wins whenever it MOVES; an app can
// change it afterwards until the switch is moved again.
void checkSourceSwitch() {
  int raw = readSourceSwitchRaw();
  unsigned long now = millis();
  if (raw != srcSwLastRaw) {
    srcSwLastRaw = raw;
    srcSwChangedAt = now;
    return;
  }
  if (raw != srcSwStable && now - srcSwChangedAt >= SRC_SW_DEBOUNCE_MS) {
    srcSwStable = raw;
    if ((raw == 1) != extSource) setSource(raw == 1);
  }
}

// Why the chip last restarted. Reported at boot and on every app connect,
// so an unexpected reboot shows up in the app's terminal.
const char *resetReasonText() {
  switch (esp_reset_reason()) {
    case ESP_RST_POWERON:  return "POWER_ON";
    case ESP_RST_EXT:      return "EXTERNAL_PIN";
    case ESP_RST_SW:       return "SOFTWARE";
    case ESP_RST_PANIC:    return "CRASH_PANIC";
    case ESP_RST_INT_WDT:  return "INTERRUPT_WATCHDOG";
    case ESP_RST_TASK_WDT: return "TASK_WATCHDOG";
    case ESP_RST_WDT:      return "OTHER_WATCHDOG";
    case ESP_RST_BROWNOUT: return "BROWNOUT_POWER_DIP";
    case ESP_RST_USB:      return "USB";
    default:               return "OTHER";
  }
}

// ---------------- COMMAND PARSER ----------------
void parseCommand(String cmd) {
  cmd.trim();
  int separator = cmd.indexOf(':');
  if (separator == -1) return;

  // ANY valid command from an app proves the link is alive, not just HEARTBEAT.
  lastHeartbeatTime = millis();

  String type = cmd.substring(0, separator);
  String val  = cmd.substring(separator + 1);

  // Over temperature: read-only. Only the link commands are accepted.
  if (overTemp && type != "CONN" && type != "HEARTBEAT") {
    broadcast("INFO:ignored=OVER TEMPERATURE; controls locked until below " + String(OT_CLEAR_C, 0) + "C");
    broadcast("THERMAL:TRIP");
    return;
  }

  if ((type == "DUTY" || type == "FREQ") && extSource) {
    broadcast("INFO:ignored=q(t) is EXTERNAL; freq and duty follow the external signal");
    broadcast("FREQ:" + String(frequency));
    broadcast("DUTY:" + String(dutyCycle));
    return;
  }
  if (type == "DUTY" && dSourceExt) {
    broadcast("INFO:ignored=duty source is the D BNC");
    broadcast("DUTY:" + String(dutyCycle));
    return;
  }
  if (type == "DUTY" || type == "FREQ") outputsLatchedOff = false;

  if (type == "CAPTEST") {
    runCaptureSelfTest();
    return;
  }

  if (type == "DSRC") {
    setDSource(val == "EXT");
    return;
  }

  if (type == "DUTY") {
    dutyCycle = constrain(val.toInt(), 0, 100);
    applyPwm();
    updateScreenValues();
    Serial.print("DUTY:"); Serial.println(dutyCycle);
    if (deviceConnected) {
      String bleMsg = "DUTY:" + String(dutyCycle) + "\n";
      pTxCharacteristic->setValue(bleMsg.c_str());
      pTxCharacteristic->notify();
    }
  }
  else if (type == "FREQ") {
    frequency = constrain((long)val.toInt(), FREQ_MIN, FREQ_MAX);
    applyPwm();
    updateScreenValues();
    Serial.print("FREQ:"); Serial.println(frequency);
    if (deviceConnected) {
      String bleMsg = "FREQ:" + String(frequency) + "\n";
      pTxCharacteristic->setValue(bleMsg.c_str());
      pTxCharacteristic->notify();
    }
  }
  else if (type == "SOURCE") {
    setSource(val == "EXT");
  }
  else if (type == "FET2") {
    if (val == "ALT")       setFetMode(MODE_ALT);
    else if (val == "ALTQ") setFetMode(MODE_ALTQ);
    else                    setFetMode(MODE_COPY);
  }
  else if (type == "CONN") {
    isConnected = (val == "ON");
    if (isConnected) {
      lastHeartbeatTime = millis();
      if (overTemp) drawOverTempScreen();
      else          redrawMainScreen();
      broadcast(overTemp ? "THERMAL:TRIP" : "THERMAL:OK");
      // Tell the app what the box is actually doing (mode may come from the panel switch).
      broadcast(String("FET2:") + modeToken(currentMode));
      reportSourceState();
      broadcast("DUTY:" + String(dutyCycle));
      broadcast("FREQ:" + String(frequency));
      broadcast(String("INFO:last_reset=") + resetReasonText() +
                " uptime_s=" + String(millis() / 1000));
    } else {
      drawStatusLight();
    }
  }
  else if (type == "HEARTBEAT") {
    lastHeartbeatTime = millis();
  }
}

// ---------------- BLE CALLBACKS ----------------
class MyServerCallbacks: public BLEServerCallbacks {
    void onConnect(BLEServer* pServer) {
      deviceConnected = true;
      isConnected = true; 
      lastHeartbeatTime = millis();
      statusLightDirty = true;
    };
    void onDisconnect(BLEServer* pServer) {
      deviceConnected = false;
      isConnected = false;
      statusLightDirty = true;
    }
};

class MyCallbacks: public BLECharacteristicCallbacks {
    void onWrite(BLECharacteristic *pCharacteristic) {
      String rxValue = pCharacteristic->getValue().c_str();
      if (rxValue.length() == 0 || cmdQueue == nullptr) return;
      // A single BLE write can carry more than one '\n'-terminated command.
      int startIdx = 0;
      while (startIdx < (int)rxValue.length()) {
        int nl = rxValue.indexOf('\n', startIdx);
        if (nl < 0) nl = rxValue.length();
        String line = rxValue.substring(startIdx, nl);
        line.trim();
        if (line.length() > 0) {
          CmdMsg m;
          strncpy(m.text, line.c_str(), sizeof(m.text) - 1);
          m.text[sizeof(m.text) - 1] = '\0';
          xQueueSend(cmdQueue, &m, 0);   // never block the BLE stack
        }
        startIdx = nl + 1;
      }
    }
};

// ---------------- ENCODERS ----------------
// Convert accumulated quadrature steps into whole clicks, keeping the remainder.
int takeDetents(volatile int32_t *steps, int32_t &residual, unsigned long &lastActivity, unsigned long timeoutMs) {
  int32_t s = __atomic_exchange_n(steps, 0, __ATOMIC_RELAXED);
  unsigned long now = millis();
  if (s != 0) {
    lastActivity = now;
  } else if (timeoutMs > 0 && residual != 0 && now - lastActivity > timeoutMs) {
    residual = 0;                      // stale partial click (likely noise): drop it
  }
  residual += s;
  int d = residual / ENC_STEPS_PER_DETENT;
  residual -= d * ENC_STEPS_PER_DETENT;
  return d;
}

void checkEncoders() {
  // Duty: cheap (one compare-register write), apply immediately.
  int dd = takeDetents(&dutyEncSteps, dutyEncResidual, dutyEncLastActivity, DUTY_ENC_RESIDUAL_TIMEOUT_MS);
  if (overTemp) dd = 0;                               // over temperature: controls locked
  if (dd != 0 && (extSource || dSourceExt)) dd = 0;   // duty comes from a BNC: knob ignored
  if (dd != 0) {
    outputsLatchedOff = false;
    dutyCycle = constrain(dutyCycle + dd * DUTY_ENC_DIR, 0, 100);
    applyPwm();
    updateScreenValues();
    broadcast("DUTY:" + String(dutyCycle));
  }

  // Frequency: accumulate clicks; rebuild the PWM at most every FREQ_APPLY_MS.
  int fd = takeDetents(&freqEncSteps, freqEncResidual, freqEncLastActivity, FREQ_ENC_RESIDUAL_TIMEOUT_MS);
  if (overTemp) fd = 0;                               // over temperature: controls locked
  if (fd != 0 && extSource) fd = 0;                  // freq follows the external q(t)
  if (fd != 0) {
    outputsLatchedOff = false;
    lastFreqTurnMs = millis();
    long step = freqFineMode ? FREQ_STEP_FINE : FREQ_STEP_COARSE;
    frequency = constrain(frequency + (long)fd * step * FREQ_ENC_DIR, FREQ_MIN, FREQ_MAX);
    freqDirty = true;
  }
  if (freqDirty && millis() - lastFreqApply >= FREQ_APPLY_MS) {
    freqDirty = false;
    lastFreqApply = millis();
    applyPwm();
    updateScreenValues();
    broadcast("FREQ:" + String(frequency));
  }
}

// Fine/coarse toggle on the frequency knob's push switch.
// A press counts only if the pin stays LOW for FREQ_SW_PRESS_MS without a single
// bounce, and only once per press (must release for FREQ_SW_RELEASE_MS first).
// Noise from touching the knob produces short spikes and never qualifies.
void pollFreqButton() {
  if (overTemp) return;                               // controls locked
  static bool lastRaw = false;      // true = LOW (pressed)
  static bool pressed = false;      // debounced state
  static unsigned long changedAt = 0;

  bool raw = (digitalRead(ENC_FREQ_SW) == LOW);
  unsigned long now = millis();
  if (raw != lastRaw) {             // any change restarts the stability timer
    lastRaw = raw;
    changedAt = now;
    return;
  }
  unsigned long stableFor = now - changedAt;

  if (raw && !pressed && stableFor >= FREQ_SW_PRESS_MS) {
    pressed = true;
    if (now - lastFreqTurnMs >= FREQ_SW_TURN_LOCKOUT_MS) {
      freqFineMode = !freqFineMode;
      screenNeedsFreqModeUpdate = true;
      broadcast(freqFineMode ? "INFO:freq_step=FINE" : "INFO:freq_step=COARSE");
    }
  } else if (!raw && pressed && stableFor >= FREQ_SW_RELEASE_MS) {
    pressed = false;
  }
}

// ---------------- SETUP ----------------
void setup() {
  // Gate-drive pins LOW before anything else so the FETs can't switch during boot.
  driveOutputsLow();

  Serial.begin(115200);
  while (!Serial && millis() < 3000) {}   // let USB enumerate so early prints aren't lost
  Serial.println("BOOT: start");
  Serial.printf("BOOT: reset reason=%s\n", resetReasonText());

  if (FAN_PIN >= 0) {
    pinMode(FAN_PIN, OUTPUT);
    digitalWrite(FAN_PIN, LOW);
  }

  // Reserved pins: park in a safe state until their features exist.
  // IO17 shares the q(t) BNC with IO18 through only R17 = 47 ohm. Driving it would
  // fight any external generator plugged into that BNC, so keep it high-Z (input,
  // no pull) until the q(t) output feature is implemented.
  pinMode(QT_INT_OUT_PIN, INPUT);
  pinMode(QT_EXT_IN_PIN, INPUT);
  // D BNC: ADC1_CH3, 11/12 dB attenuation (0 - ~3.1 V), 12-bit; calibrated via analogReadMilliVolts()
  analogReadResolution(12);
  analogSetPinAttenuation(D_EXT_PIN, ADC_11db);
  // D BNC has no pull-down on Rev 9, so an unplugged input floats and reads random
  // voltages. Enable the internal pull-down (~45 kohm) so "nothing connected" reads
  // ~0 V -> minimum duty. The first read attaches IO4 to the ADC; the pull is set
  // after that so the ADC setup can't clear it. Loading error with a 50 ohm
  // generator + R19 (100 ohm) is < 0.5%.
  analogReadMilliVolts(D_EXT_PIN);
  rtc_gpio_pullup_dis((gpio_num_t)D_EXT_PIN);
  rtc_gpio_pulldown_en((gpio_num_t)D_EXT_PIN);
  // INT/EXT source switch (closes to GND)
  pinMode(SRC_SW_PIN, INPUT_PULLUP);
  delay(5);
  srcSwLastRaw = srcSwStable = readSourceSwitchRaw();
  extSource = (srcSwStable == 1);                 // box boots with the panel's source

  // FET 2 mode switch
  pinMode(MODE_SW_UP_PIN,   MODE_SW_ACTIVE_LOW ? INPUT_PULLUP : INPUT_PULLDOWN);
  pinMode(MODE_SW_DOWN_PIN, MODE_SW_ACTIVE_LOW ? INPUT_PULLUP : INPUT_PULLDOWN);
  delay(5);                                   // let the pulls settle
  modeSwLastRaw = modeSwStable = readModeSwitchRaw();
  if (modeSwStable >= 0) currentMode = modeFromSwitch(modeSwStable);   // box boots in the panel's mode

  pinMode(ENC_DUTY_A, INPUT_PULLUP);
  pinMode(ENC_DUTY_B, INPUT_PULLUP);
  pinMode(ENC_DUTY_SW, INPUT_PULLUP);
  pinMode(ENC_FREQ_A, INPUT_PULLUP);
  pinMode(ENC_FREQ_B, INPUT_PULLUP);
  
  // Initialize Push-Button Interrupt
  pinMode(ENC_FREQ_SW, INPUT_PULLUP);
  // Fine/coarse button is polled (pollFreqButton), not interrupt-driven: an edge
  // interrupt fired on every noise spike from touching the knob.

  // Encoders: seed the decoder state, then interrupt on every edge of A and B.
  dutyEncState = readAB(ENC_DUTY_A, ENC_DUTY_B);
  freqEncState = readAB(ENC_FREQ_A, ENC_FREQ_B);
  attachInterrupt(digitalPinToInterrupt(ENC_DUTY_A), dutyEncISR, CHANGE);
  attachInterrupt(digitalPinToInterrupt(ENC_DUTY_B), dutyEncISR, CHANGE);
  attachInterrupt(digitalPinToInterrupt(ENC_FREQ_A), freqEncISR, CHANGE);
  attachInterrupt(digitalPinToInterrupt(ENC_FREQ_B), freqEncISR, CHANGE);

  cmdQueue = xQueueCreate(16, sizeof(CmdMsg));

  // Outputs stay low and IO17 high-Z until the int/ext switch is resolved (read above).
  if (extSource) {
    extNoSignal = true;
    if (!startCapture()) Serial.println("EXT: capture start failed");
  } else {
    applyPwm();
  }
  Serial.println("BOOT: pwm ok");

  // Start the SPI bus on the PCB's display pins FIRST. The display library's
  // own SPI begin() is then a no-op, so these pins are guaranteed.
  tftSPI.begin(TFT_SCLK_PIN, -1, TFT_MOSI_PIN, TFT_CS_PIN);
  tft.begin(TFT_SPI_HZ);
  Serial.println("BOOT: tft ok");
  tft.setRotation(1);
  tft.fillScreen(TFT_BLACK);
  drawInterface();
  drawStatusLight();
  updateScreenValues();
  updateFreqScaleIndicator();

  initTempSensor();
  updateTempOnScreen();

  BLEDevice::init("FET_Box_BLE");
  pServer = BLEDevice::createServer();
  pServer->setCallbacks(new MyServerCallbacks());
  BLEService *pService = pServer->createService(SERVICE_UUID);
  pTxCharacteristic = pService->createCharacteristic(CHARACTERISTIC_UUID_TX, BLECharacteristic::PROPERTY_NOTIFY);
  pTxCharacteristic->addDescriptor(new BLE2902());
  BLECharacteristic * pRxCharacteristic = pService->createCharacteristic(CHARACTERISTIC_UUID_RX, BLECharacteristic::PROPERTY_WRITE);
  pRxCharacteristic->setCallbacks(new MyCallbacks());
  pService->start();
  pServer->getAdvertising()->start();

  lastHeartbeatTime = millis();
}

// ---------------- LOOP ----------------
void loop() {
  // Non-blocking line reader: drain everything that has arrived this pass.
  // (readStringUntil() could stall loop() up to 1 s on a partial line.)
  static String serialLine;
  while (Serial.available() > 0) {
    char c = (char)Serial.read();
    if (c == '\n') {
      if (serialLine.length() > 0) parseCommand(serialLine);
      serialLine = "";
    } else if (c != '\r' && serialLine.length() < 64) {
      serialLine += c;
    }
  }

  // BLE commands, executed on this task (MCPWM + TFT are not thread-safe).
  CmdMsg m;
  while (cmdQueue && xQueueReceive(cmdQueue, &m, 0) == pdTRUE) {
    parseCommand(String(m.text));
  }

  if (statusLightDirty) {
    statusLightDirty = false;
    drawStatusLight();
  }

  checkEncoders();
  pollFreqButton();
  checkModeSwitch();
  checkSourceSwitch();
  pollDutyButton();
  serviceExtInput();
  serviceDInput();
  updateFreqScaleIndicator(); 

  if (!deviceConnected && oldDeviceConnected) {
      delay(500);
      pServer->startAdvertising(); 
      oldDeviceConnected = deviceConnected;
  }
  if (deviceConnected && !oldDeviceConnected) {
      oldDeviceConnected = deviceConnected;
  }

  // Safety Heartbeat Watchdog
  if (isConnected && (millis() - lastHeartbeatTime > WATCHDOG_TIMEOUT_MS)) {
    pwmSafeOff();
    isConnected = false; 
    if (!overTemp) {
    tft.fillScreen(TFT_RED);
    tft.setTextColor(TFT_WHITE, TFT_RED);
    tft.setTextSize(3);
    tft.setCursor(20, 100);
    tft.print("LINK LOST!");
    tft.setTextSize(2);
    tft.setCursor(40, 150);
    tft.print("Safety Shutdown");
    }
  }

  // Temperature Polling & Fan Hysteresis Control
  if (millis() - lastTempUpdate > 1000) {
    pollTemperature();
    checkThermal();

    if (FAN_PIN >= 0) {
      if (tempOk && !isnan(tempC)) {
        if (tempC >= FAN_ON_TEMP)       digitalWrite(FAN_PIN, HIGH);
        else if (tempC <= FAN_OFF_TEMP) digitalWrite(FAN_PIN, LOW);
      } else {
        digitalWrite(FAN_PIN, HIGH);    // sensor failed: fail safe, run the fan
      }
    }

    String tempMsg = (!tempOk) ? "TEMP:ERR\n" : "TEMP:" + String(tempC, 2) + "\n";
    Serial.print(tempMsg);
    if (deviceConnected) {
      pTxCharacteristic->setValue(tempMsg.c_str());
      pTxCharacteristic->notify();
    }

    updateTempOnScreen();
    lastTempUpdate = millis();
  }
}
