  return true;
}

// Build the whole MCPWM chain for a given mode + frequency.
bool pwmBuild(FetMode mode, long f) {
  pwmTeardown();
  const bool altq = (mode == MODE_ALTQ);

  // Pick the fastest timer clock (80 MHz / 2^k) whose period still fits in
  // the 16-bit counter. ALTQ needs room for 2*T.
  const uint32_t maxBase = altq ? 32767 : 65535;
  uint32_t res = MCPWM_BASE_RES_HZ;
  while (res > MCPWM_MIN_RES_HZ && ((res + f / 2) / f) > maxBase) res >>= 1;

  uint32_t base = (res + f / 2) / f;          // ticks per switching period T
  if (base > maxBase) base = maxBase;
  if (base < 4) base = 4;
  const uint32_t period = altq ? 2 * base : base;   // always even in ALTQ

  uint32_t dt = (uint32_t)(((uint64_t)DEADTIME_NS * res + 500000000ULL) / 1000000000ULL);
  if (dt < 1) dt = 1;

  mcpwm_timer_config_t tc = {};
  tc.group_id      = 0;
  tc.clk_src       = MCPWM_TIMER_CLK_SRC_DEFAULT;
  tc.resolution_hz = res;
  tc.count_mode    = MCPWM_TIMER_COUNT_MODE_UP;
  tc.period_ticks  = period;
  MC_CHECK(mcpwm_new_timer(&tc, &hw.timer));

  mcpwm_operator_config_t oc = {};
  oc.group_id = 0;
  MC_CHECK(mcpwm_new_operator(&oc, &hw.op0));
  MC_CHECK(mcpwm_operator_connect_timer(hw.op0, hw.timer));
  if (!newCmpr(hw.op0, &hw.c0)) return false;
  if (!newGen(hw.op0, PWM_OUT_PIN, &hw.g1)) return false;

  // FET1 is identical in every mode: high at counter zero, low at c0.
  MC_CHECK(onTimerEvent(hw.g1, MCPWM_TIMER_EVENT_EMPTY, MCPWM_GEN_ACTION_HIGH));
  MC_CHECK(onCompare(hw.g1, hw.c0, MCPWM_GEN_ACTION_LOW));

  if (mode == MODE_COPY || mode == MODE_ALT) {
    if (!newGen(hw.op0, PWM_OUT_PIN2, &hw.g2)) return false;
    MC_CHECK(onTimerEvent(hw.g2, MCPWM_TIMER_EVENT_EMPTY, MCPWM_GEN_ACTION_HIGH));
    MC_CHECK(onCompare(hw.g2, hw.c0, MCPWM_GEN_ACTION_LOW));

    if (mode == MODE_ALT) {
      // Active-high complementary with dead time on both transitions.
      mcpwm_dead_time_config_t d1 = {};
      d1.posedge_delay_ticks = dt;
      d1.negedge_delay_ticks = 0;
      MC_CHECK(mcpwm_generator_set_dead_time(hw.g1, hw.g1, &d1));
      mcpwm_dead_time_config_t d2 = {};
      d2.posedge_delay_ticks = 0;
      d2.negedge_delay_ticks = dt;
      d2.flags.invert_output = true;
      MC_CHECK(mcpwm_generator_set_dead_time(hw.g1, hw.g2, &d2));
    }
  } else {
    // ALTQ: second operator on the SAME timer -> same counter, zero skew.
    MC_CHECK(mcpwm_new_operator(&oc, &hw.op1));
    MC_CHECK(mcpwm_operator_connect_timer(hw.op1, hw.timer));
    if (!newCmpr(hw.op1, &hw.c1a)) return false;
    if (!newCmpr(hw.op1, &hw.c1b)) return false;
    if (!newGen(hw.op1, PWM_OUT_PIN2, &hw.g2)) return false;
    MC_CHECK(onCompare(hw.g2, hw.c1a, MCPWM_GEN_ACTION_HIGH));
    MC_CHECK(onCompare(hw.g2, hw.c1b, MCPWM_GEN_ACTION_LOW));
    MC_CHECK(mcpwm_comparator_set_compare_value(hw.c1a, period / 2));
  }

  hw.resHz = res;  hw.period = period;  hw.base = base;  hw.dtTicks = dt;

  // Hold outputs low until the first compare values are loaded.
  mcpwm_generator_set_force_level(hw.g1, 0, true);
  mcpwm_generator_set_force_level(hw.g2, 0, true);

  // q(t) reference on IO17 (master mode only). Started before the main timer so
  // the very first main-timer TEZ aligns it.
  if (!extSource) {
    if (!buildQRef(res, base)) return false;
  }

  MC_CHECK(mcpwm_timer_enable(hw.timer));
  hw.enabled = true;
  MC_CHECK(mcpwm_timer_start_stop(hw.timer, MCPWM_TIMER_START_NO_STOP));

  hw.built = true;
  hw.builtFreq = f;
  hw.builtMode = mode;

  Serial.printf("PWM:res=%lu Hz period=%lu ticks base=%lu dt=%lu f_actual=%.1f Hz\n",
                (unsigned long)res, (unsigned long)period, (unsigned long)base,
                (unsigned long)dt, (double)res / (double)base);
  return true;
}

// Largest duty (%) allowed in ALTQ so FET1 and FET2 can never overlap and
// keep at least one dead time between them.
int altqMaxDuty() {
  if (!hw.built || hw.base == 0) return 50;
  uint32_t usable = (hw.base > hw.dtTicks) ? hw.base - hw.dtTicks : 0;
  return (int)((usable * 100UL) / hw.base);
}

// Update duty only. Glitch-free: new compare values load at the next TEZ.
void pwmSetDuty(int duty) {
  if (!hw.built) return;
  setQRefDuty(duty);                   // q(t) BNC = plain base waveform, independent of FET 2 mode

  if (duty <= 0) {                       // 0 % = both FETs hard off in every mode
    mcpwm_generator_set_force_level(hw.g1, 0, true);
    mcpwm_generator_set_force_level(hw.g2, 0, true);
    return;
  }

  if (hw.builtMode == MODE_ALTQ) {
    uint32_t on = (uint32_t)(((uint64_t)duty * hw.base + 50) / 100);
    uint32_t maxOn = (hw.base > hw.dtTicks) ? hw.base - hw.dtTicks : 1;
    if (on > maxOn) on = maxOn;
    if (on < 1) on = 1;
    mcpwm_comparator_set_compare_value(hw.c0,  on);
    mcpwm_comparator_set_compare_value(hw.c1b, hw.period / 2 + on);
    mcpwm_generator_set_force_level(hw.g1, -1, true);
    mcpwm_generator_set_force_level(hw.g2, -1, true);
    return;
  }

  if (duty >= 100) {                     // steady on (ALT: FET2 then stays off)
    mcpwm_generator_set_force_level(hw.g1, 1, true);
    if (hw.builtMode == MODE_COPY) mcpwm_generator_set_force_level(hw.g2, 1, true);
    else                           mcpwm_generator_set_force_level(hw.g2, -1, true);
    return;
  }

  uint32_t on = (uint32_t)(((uint64_t)duty * hw.period + 50) / 100);
  if (on < 1) on = 1;
  if (on > hw.period - 1) on = hw.period - 1;
  mcpwm_comparator_set_compare_value(hw.c0, on);
  mcpwm_generator_set_force_level(hw.g1, -1, true);
  mcpwm_generator_set_force_level(hw.g2, -1, true);
}

// Public entry point (same name as before so the rest of the sketch is unchanged).
// Rebuilds only when mode or frequency changes; duty-only changes are a
// single compare-register write.
void applyPwm() {
  // Over temperature: outputs stay off no matter what else asks for them.
  if (overTemp) {
    if (hw.built) pwmTeardown();
    return;
  }
  // q(t) EXT selected but no valid external signal: keep outputs off.
  if (extSource && extNoSignal) {
    if (hw.built) pwmTeardown();
    return;
  }
  long f = constrain(frequency, FREQ_MIN, FREQ_MAX);
  frequency = f;

  if (!hw.built || hw.builtFreq != f || hw.builtMode != currentMode) {
    if (!pwmBuild(currentMode, f)) {
      pwmTeardown();
      return;
    }
  }

  if (currentMode == MODE_ALTQ) {
    int mx = altqMaxDuty();
    if (dutyCycle > mx) dutyCycle = mx;   // echoed back to both GUIs as DUTY:
  }
  dutyCycle = constrain(dutyCycle, 0, 100);
  pwmSetDuty(dutyCycle);
}

// Hard safety stop used by the heartbeat watchdog.
void pwmSafeOff() {
  dutyCycle = 0;
  outputsLatchedOff = true;           // ext/D inputs may not restart outputs on their own
  pwmTeardown();      // releases MCPWM and drives both pins LOW via GPIO
}

// =====================================================================
// q(t) REFERENCE OUTPUT (IO17, master/int mode)
// Plain base waveform at the set frequency and duty, BEFORE FET 2 mode logic,
// so the BNC output does not change when the mode switch moves. It runs on its
// own timer (period = T) phase-reset by the main timer's TEZ, so it stays aligned
// in all modes (the main timer runs at 2T in Alternate). Alignment is within the
// sync latency (a few 12.5 ns ticks); fine for a reference/master output.
// =====================================================================
bool buildQRef(uint32_t res, uint32_t base) {
  mcpwm_timer_config_t tc = {};
  tc.group_id      = 0;
  tc.clk_src       = MCPWM_TIMER_CLK_SRC_DEFAULT;
  tc.resolution_hz = res;
  tc.count_mode    = MCPWM_TIMER_COUNT_MODE_UP;
  tc.period_ticks  = base;
  MC_CHECK(mcpwm_new_timer(&tc, &hw.timerQ));

  mcpwm_operator_config_t oc = {};
  oc.group_id = 0;
  MC_CHECK(mcpwm_new_operator(&oc, &hw.opQ));
  MC_CHECK(mcpwm_operator_connect_timer(hw.opQ, hw.timerQ));
  if (!newCmpr(hw.opQ, &hw.cmpQ)) return false;
  if (!newGen(hw.opQ, QT_INT_OUT_PIN, &hw.genQ)) return false;
  MC_CHECK(onTimerEvent(hw.genQ, MCPWM_TIMER_EVENT_EMPTY, MCPWM_GEN_ACTION_HIGH));
  MC_CHECK(onCompare(hw.genQ, hw.cmpQ, MCPWM_GEN_ACTION_LOW));

  mcpwm_timer_sync_src_config_t sc = {};
  sc.timer_event = MCPWM_TIMER_EVENT_EMPTY;
  MC_CHECK(mcpwm_new_timer_sync_src(hw.timer, &sc, &hw.syncQ));
  mcpwm_timer_sync_phase_config_t ph = {};
  ph.sync_src    = hw.syncQ;
  ph.count_value = 0;
  ph.direction   = MCPWM_TIMER_DIRECTION_UP;
  MC_CHECK(mcpwm_timer_set_phase_on_sync(hw.timerQ, &ph));

  mcpwm_generator_set_force_level(hw.genQ, 0, true);   // low until duty is set
  MC_CHECK(mcpwm_timer_enable(hw.timerQ));
  hw.enabledQ = true;
  MC_CHECK(mcpwm_timer_start_stop(hw.timerQ, MCPWM_TIMER_START_NO_STOP));
  return true;
}

void teardownQRef() {
  if (hw.genQ) mcpwm_generator_set_force_level(hw.genQ, 0, true);
  if (hw.timerQ && hw.enabledQ) {
    mcpwm_timer_start_stop(hw.timerQ, MCPWM_TIMER_STOP_EMPTY);
    mcpwm_timer_disable(hw.timerQ);
    hw.enabledQ = false;
  }
  if (hw.timerQ && hw.syncQ) {
    mcpwm_timer_sync_phase_config_t ph = {};          // sync_src = NULL detaches
    mcpwm_timer_set_phase_on_sync(hw.timerQ, &ph);
  }
  if (hw.genQ)  { mcpwm_del_generator(hw.genQ);   hw.genQ  = nullptr; }
  if (hw.cmpQ)  { mcpwm_del_comparator(hw.cmpQ);  hw.cmpQ  = nullptr; }
  if (hw.opQ)   { mcpwm_del_operator(hw.opQ);     hw.opQ   = nullptr; }
  if (hw.timerQ){ mcpwm_del_timer(hw.timerQ);     hw.timerQ = nullptr; }
  if (hw.syncQ) { mcpwm_del_sync_src(hw.syncQ);   hw.syncQ = nullptr; }
  // Release IO17: high-Z, no pull. In EXT mode this is what keeps it from
  // fighting the external generator through R17 (47 ohm).
  pinMode(QT_INT_OUT_PIN, INPUT);
}

void setQRefDuty(int duty) {
  if (!hw.genQ || hw.base == 0) return;
  if (duty <= 0)   { mcpwm_generator_set_force_level(hw.genQ, 0, true); return; }
  if (duty >= 100) { mcpwm_generator_set_force_level(hw.genQ, 1, true); return; }
  uint32_t on = (uint32_t)(((uint64_t)duty * hw.base + 50) / 100);
  if (on < 1) on = 1;
  if (on > hw.base - 1) on = hw.base - 1;
  mcpwm_comparator_set_compare_value(hw.cmpQ, on);
  mcpwm_generator_set_force_level(hw.genQ, -1, true);
}

// =====================================================================
// PURE MATH (no hardware access; unit-testable)
// =====================================================================
float clampf(float v, float lo, float hi) { return v < lo ? lo : (v > hi ? hi : v); }

// Frequency from the time of N consecutive cycles (capture prescale = N).
float extFreqFromCapture(uint32_t ticksForNCycles, uint32_t nCycles, uint32_t capResHz) {
  if (ticksForNCycles == 0 || nCycles == 0) return 0;
  return (float)((double)capResHz * nCycles / ticksForNCycles);
}

// Duty (%) from ANY rising-edge timestamp and ANY later-or-earlier falling-edge
// timestamp of the same periodic signal: high time = (fall - rise) mod period.
// Works with prescaled captures where rise and fall come from different cycles.
float extDutyFromEdges(uint32_t riseTs, uint32_t fallTs, float ticksPerCycle) {
  if (ticksPerCycle <= 0) return 0;
  // Signed difference: the latest fall may be before OR after the latest rise.
  // (Unsigned would wrap to ~2^32, which is not a multiple of the period.)
  // Valid while |fall - rise| < 2^31 ticks (~26 s at 80 MHz).
  int32_t d = (int32_t)(fallTs - riseTs);
  double high = fmod((double)d, (double)ticksPerCycle);
  if (high < 0) high += ticksPerCycle;
  return (float)(100.0 * high / ticksPerCycle);
}

// D BNC: linear map 0.2 V -> 5% ... 3.0 V -> 95%, clamped outside that range.
float dDutyFromMillivolts(float mv) {
  float frac = clampf((mv - (float)D_V_MIN_MV) / (float)(D_V_FULL_SCALE_MV - D_V_MIN_MV), 0.0f, 1.0f);
  if (D_INVERT) frac = 1.0f - frac;
  return clampf(D_DUTY_MIN_PCT + frac * (D_DUTY_MAX_PCT - D_DUTY_MIN_PCT),
                D_DUTY_MIN_PCT, D_DUTY_MAX_PCT);
}

// =====================================================================
// q(t) EXTERNAL INPUT (IO18, slave/ext mode) via MCPWM capture (group 1)
// Two capture channels on the same pin: every 16th rising edge and every 16th
// falling edge. Period = (rise - previous rise)/16; duty from the rise/fall
// offset modulo the period. Interrupt rate stays <= ~40 kHz even at 300 kHz.
// PWM-A/B FOLLOW the external frequency and duty through the normal mode logic.
// They are frequency-matched, not phase-locked (see notes).
// =====================================================================
bool IRAM_ATTR onCapRise(mcpwm_cap_channel_handle_t ch, const mcpwm_capture_event_data_t *e, void *u) {
  portENTER_CRITICAL_ISR(&capMux);
  capRisePrevTs = capRiseTs;
  capRiseTs     = e->cap_value;
  capRiseCount++;
  capLastEdgeUs = esp_timer_get_time();
  portEXIT_CRITICAL_ISR(&capMux);
  return false;
}

bool IRAM_ATTR onCapFall(mcpwm_cap_channel_handle_t ch, const mcpwm_capture_event_data_t *e, void *u) {
  portENTER_CRITICAL_ISR(&capMux);
  capFallTs = e->cap_value;
  capFallCount++;
  portEXIT_CRITICAL_ISR(&capMux);
  return false;
}

bool newCapChannel(bool rising, mcpwm_cap_channel_handle_t *out) {
  mcpwm_capture_channel_config_t cc = {};
  cc.gpio_num        = QT_EXT_IN_PIN;
  cc.prescale        = EXT_CAP_PRESCALE;
  cc.flags.pos_edge  = rising;
  cc.flags.neg_edge  = !rising;
  cc.flags.pull_down = true;   // nothing plugged in -> line held low -> no edges -> safe timeout
  MC_CHECK(mcpwm_new_capture_channel(capTimer, &cc, out));
  mcpwm_capture_event_callbacks_t cb = {};
  cb.on_cap = rising ? onCapRise : onCapFall;
  MC_CHECK(mcpwm_capture_channel_register_event_callbacks(*out, &cb, nullptr));
  MC_CHECK(mcpwm_capture_channel_enable(*out));
  return true;
}

bool startCapture() {
  if (capRunning) return true;
  portENTER_CRITICAL(&capMux);
  capRiseTs = capRisePrevTs = capFallTs = 0;
  capRiseCount = capFallCount = 0;
  capLastEdgeUs = 0;
  portEXIT_CRITICAL(&capMux);

  mcpwm_capture_timer_config_t tc = {};
  tc.group_id = EXT_CAP_GROUP;
  tc.clk_src  = MCPWM_CAPTURE_CLK_SRC_DEFAULT;
  MC_CHECK(mcpwm_new_capture_timer(&tc, &capTimer));
  MC_CHECK(mcpwm_capture_timer_get_resolution(capTimer, &capResHz));
  if (!newCapChannel(true,  &capChRise)) { stopCapture(); return false; }
  if (!newCapChannel(false, &capChFall)) { stopCapture(); return false; }
  MC_CHECK(mcpwm_capture_timer_enable(capTimer));
  MC_CHECK(mcpwm_capture_timer_start(capTimer));
  capRunning = true;
  Serial.printf("EXT: capture on IO%d, %lu Hz timer, prescale %d\n",
                QT_EXT_IN_PIN, (unsigned long)capResHz, EXT_CAP_PRESCALE);
  return true;
}

void stopCapture() {
  if (capTimer && capRunning) {
    mcpwm_capture_timer_stop(capTimer);
    mcpwm_capture_timer_disable(capTimer);
  }
  if (capChRise) { mcpwm_capture_channel_disable(capChRise); mcpwm_del_capture_channel(capChRise); capChRise = nullptr; }
  if (capChFall) { mcpwm_capture_channel_disable(capChFall); mcpwm_del_capture_channel(capChFall); capChFall = nullptr; }
  if (capTimer)  { mcpwm_del_capture_timer(capTimer); capTimer = nullptr; }
  capRunning = false;
  pinMode(QT_EXT_IN_PIN, INPUT);
}

void serviceExtInput() {
  static unsigned long lastRun = 0;
  if (!extSource || !capRunning) return;
  unsigned long nowMs = millis();
  if (nowMs - lastRun < EXT_UPDATE_MS) return;
  lastRun = nowMs;

  uint32_t rise, risePrev, fall, nRise, nFall; int64_t lastEdge;
  portENTER_CRITICAL(&capMux);
  rise = capRiseTs; risePrev = capRisePrevTs; fall = capFallTs;
  nRise = capRiseCount; nFall = capFallCount; lastEdge = capLastEdgeUs;
  portEXIT_CRITICAL(&capMux);

  bool valid = (nRise >= 2 && nFall >= 1 &&
                esp_timer_get_time() - lastEdge < (int64_t)EXT_SIGNAL_TIMEOUT_MS * 1000);
  float f = 0, d = 0;
  if (valid) {
    uint32_t span = rise - risePrev;                  // ticks for EXT_CAP_PRESCALE cycles
    f = extFreqFromCapture(span, EXT_CAP_PRESCALE, capResHz);
    d = extDutyFromEdges(rise, fall, (float)span / EXT_CAP_PRESCALE);
    if (f < EXT_NOISE_FLOOR_HZ) valid = false;
  }

  if (!valid) {
    if (!extNoSignal) {
      extNoSignal = true;
      pwmTeardown();                                  // outputs forced low
      extAppliedDuty = -100;
      updateScreenValues();
      broadcast("INFO:ext=NO_SIGNAL");
    }
    return;
  }
  if (outputsLatchedOff) return;                      // watchdog tripped: wait for user/app

  float fC = clampf(f, EXT_FREQ_MIN_HZ, EXT_FREQ_MAX_HZ);
  float dC = clampf(d, EXT_DUTY_MIN_PCT, EXT_DUTY_MAX_PCT);
  bool wasNoSignal = extNoSignal;
  extNoSignal = false;

  bool fChange = wasNoSignal || frequency <= 0 ||
                 fabsf(fC - (float)frequency) * 100.0f / (float)frequency > EXT_FREQ_HYST_PCT;
  bool dChange = wasNoSignal || fabsf(dC - extAppliedDuty) >= EXT_DUTY_HYST_PCT;
  if (!fChange && !dChange) return;

  if (fChange) frequency = lroundf(fC);
  extAppliedDuty = dC;
  dutyCycle = lroundf(dC);
  applyPwm();

  if (wasNoSignal) broadcast("INFO:ext=LOCKED");
  if (wasNoSignal || nowMs - lastExtReport >= 250) {
    lastExtReport = nowMs;
    updateScreenValues();
    broadcast("FREQ:" + String(frequency));
    broadcast("DUTY:" + String(dutyCycle));
  }
}

// =====================================================================
// D BNC ANALOG DUTY (IO4, ADC1_CH3) - used only with INTERNAL q(t) and D selected
// =====================================================================
void serviceDInput() {
  static unsigned long lastRun = 0;
  if (!dSourceExt || extSource || outputsLatchedOff) return;
  unsigned long nowMs = millis();
  if (nowMs - lastRun < D_SAMPLE_MS) return;
  lastRun = nowMs;

  float mv = (float)analogReadMilliVolts(D_EXT_PIN);  // calibrated (eFuse/curve fitting) mV
  dFiltMv = (dFiltMv < 0) ? mv : dFiltMv + D_FILTER_ALPHA * (mv - dFiltMv);
  float target = dDutyFromMillivolts(dFiltMv);
  if (fabsf(target - dAppliedDuty) < D_HYST_PCT) return;
  dAppliedDuty = target;

  int newDuty = lroundf(target);
  if (newDuty == dutyCycle) return;
  dutyCycle = newDuty;
  applyPwm();                                          // compare update on TEZ: glitch-free
  if (nowMs - lastDReport >= 250) {
    lastDReport = nowMs;
    updateScreenValues();
    broadcast("DUTY:" + String(dutyCycle));
  }
}

void setDSource(bool ext) {
  dSourceExt = ext;
  dFiltMv = -1;
  dAppliedDuty = -100;
  outputsLatchedOff = false;
  updateScreenValues();
  broadcast(ext ? "DSRC:EXT" : "DSRC:INT");
  if (ext && extSource) broadcast("INFO:d_ignored=q(t) is EXTERNAL; duty comes from the external q(t)");
}

// Duty knob push button: hold DUTY_SW_HOLD_MS to toggle the duty source.
void pollDutyButton() {
  if (overTemp) return;                               // controls locked
  static bool lastRaw = false, held = false;
  static unsigned long changedAt = 0;
  bool raw = (digitalRead(ENC_DUTY_SW) == LOW);
  unsigned long now = millis();
  if (raw != lastRaw) { lastRaw = raw; changedAt = now; if (!raw) held = false; return; }
  if (raw && !held && now - changedAt >= DUTY_SW_HOLD_MS) {
    held = true;                                       // once per press
    setDSource(!dSourceExt);
  }
}

// CAPTEST: loopback check of the external-q(t) measurement path.
// In INT mode the box drives its own q(t) on IO17, and IO18 sees the same BNC
// net, so the capture should measure exactly the frequency/duty we set.
// Any constant ratio between set and measured = capture clock/count error.
void runCaptureSelfTest() {
  if (extSource) { broadcast("INFO:captest=switch to INT first (test measures the box's own q(t))"); return; }
  if (!hw.built || dutyCycle <= 0 || dutyCycle >= 100) {
    broadcast("INFO:captest=set a duty between 1 and 99 % first"); return;
  }
  if (!startCapture()) { broadcast("INFO:captest=capture start failed"); return; }
  delay(300 + (unsigned long)(2000.0 * EXT_CAP_PRESCALE / max(frequency, 1L)));  // >= a few capture events
  uint32_t rise, risePrev, fall, nRise, nFall;
  portENTER_CRITICAL(&capMux);
  rise = capRiseTs; risePrev = capRisePrevTs; fall = capFallTs; nRise = capRiseCount; nFall = capFallCount;
  portEXIT_CRITICAL(&capMux);
  uint32_t res = capResHz;
  stopCapture();
  if (nRise < 2 || nFall < 1) {
    broadcast("INFO:captest=no edges seen on IO18 (check R20 / the q(t) net)"); return;
  }
  uint32_t span = rise - risePrev;
  float f = extFreqFromCapture(span, EXT_CAP_PRESCALE, res);
  float d = extDutyFromEdges(rise, fall, (float)span / EXT_CAP_PRESCALE);
  float ratio = f / (float)frequency;
  broadcast("INFO:captest set_f=" + String(frequency) + " meas_f=" + String(f, 1) +
            " ratio=" + String(ratio, 4) + " set_d=" + String(dutyCycle) + " meas_d=" + String(d, 1) +
            " cap_res=" + String(res) + " span16=" + String(span));
}

void reportSourceState() {
  broadcast(extSource ? "SOURCE:EXT" : "SOURCE:INT");
  broadcast(dSourceExt ? "DSRC:EXT" : "DSRC:INT");
  if (extSource) broadcast(extNoSignal ? "INFO:ext=NO_SIGNAL" : "INFO:ext=LOCKED");
}

