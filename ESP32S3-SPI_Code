#include <SPI.h>
#include <TFT_eSPI.h>
#include <OneWire.h>
#include <DallasTemperature.h>

TFT_eSPI tft = TFT_eSPI();

// ---------------- PINS ----------------
// DUTY ENCODER (Knob 1)
#define ENC_DUTY_A 6
#define ENC_DUTY_B 7
#define ENC_DUTY_SW 4

// FREQ ENCODER (Knob 2)
#define ENC_FREQ_A 15
#define ENC_FREQ_B 16
#define ENC_FREQ_SW 17

// PWM OUTPUT PIN
#define PWM_OUT_PIN 8

// DS18B20 DATA PIN
#define DS18B20_PIN 18

// ---------------- DS18B20 ----------------
OneWire oneWire(DS18B20_PIN);
DallasTemperature sensors(&oneWire);

// ---------------- STATE ----------------
int  dutyCycle = 50;         // %
long frequency = 1000;       // Hz (requested)

bool extSource = false;
bool altMode   = false;
bool isConnected = false;

unsigned long lastHeartbeatTime = 0;

float tempC = NAN;
bool  tempOk = false;

int lastDutyA = HIGH;
int lastFreqA = HIGH;

unsigned long lastTempUpdate = 0;

// Track what we applied
long lastAppliedFreq = -1;
int  lastAppliedDuty = -1;
int  lastAppliedRes  = -1;

// What hardware actually set
uint32_t actualFreq = 0;

// ---------------- PWM CONFIG (AUTO RES) ----------------
// You want up to 500 kHz:
const long FREQ_MIN = 1;
const long FREQ_MAX = 500000;

// Frequency step from encoder (you can tune)
long freqStep = 100; // will auto-scale based on current frequency

// Pick resolution based on target frequency.
// Higher frequency => fewer bits.
int pickResolutionBits(long f) {
  if (f <= 20000)   return 10; 
  if (f <= 80000)   return 8;  
  if (f <= 200000)  return 4; // Lowered from 250k to 200k for stability
  if (f <= 400000)  return 2; // Added a 2nd-bit stage (0, 25, 50, 75, 100%)
  return 1;                   // Force 1-bit for 400kHz to 500kHz
}

uint32_t maxCountsForRes(int resBits) {
  if (resBits <= 0) return 1;
  if (resBits >= 31) return 0x7FFFFFFF;
  return (1u << resBits) - 1u;
}

uint32_t dutyPercentToCounts(int dPercent, int resBits) {
  dPercent = constrain(dPercent, 0, 100);
  uint32_t maxc = maxCountsForRes(resBits);
  return (uint32_t)((uint64_t)dPercent * (uint64_t)maxc / 100ull);
}

void initPwm() {
  // Attach once with a reasonable starting resolution for initial frequency
  int res = pickResolutionBits(frequency);
  bool ok = ledcAttach(PWM_OUT_PIN, (uint32_t)constrain(frequency, FREQ_MIN, FREQ_MAX), res);

  Serial.print("ledcAttach = ");
  Serial.println(ok ? "OK" : "FAIL");

  lastAppliedFreq = -1;
  lastAppliedDuty = -1;
  lastAppliedRes  = -1;

  // Apply immediately
  // (This will call ledcChangeFrequency + ledcWrite)
  // so we get REQ/ACT prints.
}

void applyPwm() {
  long fReq = constrain(frequency, FREQ_MIN, FREQ_MAX);
  int  dReq = constrain(dutyCycle, 0, 100);

  int resReq = pickResolutionBits(fReq);

  // If resolution changes, re-attach with new resolution
  if (resReq != lastAppliedRes) {
    // Re-attach at new resolution & current freq
    bool ok = ledcAttach(PWM_OUT_PIN, (uint32_t)fReq, resReq);
    Serial.print("PWM reattach res=");
    Serial.print(resReq);
    Serial.print(" -> ");
    Serial.println(ok ? "OK" : "FAIL");

    lastAppliedRes = resReq;
    lastAppliedFreq = -1; // force freq update after reattach
    lastAppliedDuty = -1; // force duty rewrite after reattach
  }

  // Frequency update
  if (fReq != lastAppliedFreq) {
    actualFreq = ledcChangeFrequency(PWM_OUT_PIN, (uint32_t)fReq, lastAppliedRes);

    Serial.print("PWM FREQ  REQ=");
    Serial.print(fReq);
    Serial.print(" Hz  ACT=");
    Serial.print(actualFreq);
    Serial.print(" Hz  RES=");
    Serial.println(lastAppliedRes);

    lastAppliedFreq = fReq;
  }

  // Duty update (note: at 1-bit resolution, duty options are extremely limited)
  if (dReq != lastAppliedDuty) {
    uint32_t dutyCounts = dutyPercentToCounts(dReq, lastAppliedRes);
    ledcWrite(PWM_OUT_PIN, dutyCounts);
    lastAppliedDuty = dReq;
  }
}

// ---------------- UI ----------------
void drawStatusLight() {
  int x = 300, y = 20, radius = 8;
  tft.fillRect(250, 10, 70, 20, TFT_BLUE);

  if (isConnected) {
    tft.fillCircle(x, y, radius, TFT_GREEN);
    tft.setTextColor(TFT_GREEN, TFT_BLUE);
    tft.setTextSize(1);
    tft.setCursor(260, 15);
    tft.print("LINK OK");
  } else {
    tft.fillCircle(x, y, radius, TFT_RED);
    tft.setTextColor(TFT_RED, TFT_BLUE);
    tft.setTextSize(1);
    tft.setCursor(260, 15);
    tft.print("NO LINK");
  }
}

void drawInterface() {
  tft.fillRect(0, 0, 320, 40, TFT_BLUE);
  tft.setTextColor(TFT_WHITE, TFT_BLUE);
  tft.setTextSize(2);
  tft.setCursor(10, 10);
  tft.println("FET BOX CONTROL");

  tft.setTextColor(TFT_WHITE, TFT_BLACK);
  tft.setTextSize(2);

  tft.setCursor(10, 60);   tft.print("Duty:");
  tft.setCursor(10, 100);  tft.print("Freq:");
  tft.setCursor(10, 140);  tft.print("Src:");
  tft.setCursor(10, 180);  tft.print("FET2:");
  tft.setCursor(10, 220);  tft.print("Temp:");
}

void updateScreenValues() {
  tft.setTextSize(2);
  tft.setTextColor(TFT_GREEN, TFT_BLACK);

  // Duty
  tft.setCursor(80, 60);  tft.print("        ");
  tft.setCursor(80, 60);  tft.print(dutyCycle); tft.print(" %");

  // Freq (show requested)
  tft.setCursor(80, 100); tft.print("            ");
  tft.setCursor(80, 100); tft.print(frequency); tft.print(" Hz");

  // Optional: show actual + res in Serial (already), but keep screen simple

  // Source
  tft.setCursor(80, 140); tft.print("        ");
  tft.setCursor(80, 140);
  if (extSource) tft.print("EXTERNAL");
  else           tft.print("INTERNAL");

  // FET2 mode
  tft.setCursor(80, 180); tft.print("          ");
  tft.setCursor(80, 180);
  if (altMode) tft.print("ALTERNATE");
  else         tft.print("COPY (q)");
}

// ---------------- TEMP ----------------
void initTempSensor() {
  sensors.begin();
  sensors.setWaitForConversion(false);
  sensors.requestTemperatures();
}

void pollTemperature() {
  float t = sensors.getTempCByIndex(0);
  if (t == DEVICE_DISCONNECTED_C) {
    tempOk = false;
  } else {
    tempOk = true;
    tempC = t;
  }
  sensors.requestTemperatures();
}

void updateTempOnScreen() {
  tft.setTextSize(2);

  tft.setCursor(80, 220);
  tft.setTextColor(TFT_GREEN, TFT_BLACK);
  tft.print("            ");
  tft.setCursor(80, 220);

  if (!tempOk) {
    tft.setTextColor(TFT_RED, TFT_BLACK);
    tft.print("SENSOR ERR");
    tft.setTextColor(TFT_GREEN, TFT_BLACK);
  } else {
    tft.setTextColor(TFT_GREEN, TFT_BLACK);
    tft.print(tempC, 2);
    tft.print(" C");
  }
}

// ---------------- SERIAL PARSE ----------------
void parseCommand(String cmd) {
  cmd.trim();
  int separator = cmd.indexOf(':');
  if (separator == -1) return;

  String type = cmd.substring(0, separator);
  String val  = cmd.substring(separator + 1);

  if (type == "DUTY") {
    dutyCycle = constrain(val.toInt(), 0, 100);
    applyPwm();
    updateScreenValues();
    Serial.print("DUTY:"); Serial.println(dutyCycle);
  }
  else if (type == "FREQ") {
    frequency = constrain((long)val.toInt(), FREQ_MIN, FREQ_MAX);
    applyPwm();
    updateScreenValues();
    Serial.print("FREQ:"); Serial.println(frequency);
  }
  else if (type == "SOURCE") {
    extSource = (val == "EXT");
    updateScreenValues();
  }
  else if (type == "FET2") {
    altMode = (val == "ALT");
    updateScreenValues();
  }
  else if (type == "CONN") {
    isConnected = (val == "ON");
    if (isConnected) lastHeartbeatTime = millis();
    drawStatusLight();
  }
  else if (type == "HEARTBEAT") {
    lastHeartbeatTime = millis();
  }
}

// ---------------- ENCODERS ----------------
void updateFreqStep() {
  // Auto step scaling so you can actually reach 500k quickly
  long f = constrain(frequency, FREQ_MIN, FREQ_MAX);
  if      (f < 10000)   freqStep = 100;
  else if (f < 100000)  freqStep = 1000;
  else if (f < 300000)  freqStep = 5000;
  else                  freqStep = 10000;
}

void checkEncoders() {
  // DUTY knob
  int dutyA = digitalRead(ENC_DUTY_A);
  if (lastDutyA == HIGH && dutyA == LOW) {
    int dutyB = digitalRead(ENC_DUTY_B);
    if (dutyB == LOW) dutyCycle--;
    else              dutyCycle++;

    dutyCycle = constrain(dutyCycle, 0, 100);
    applyPwm();
    updateScreenValues();
    Serial.print("DUTY:"); Serial.println(dutyCycle);
    delay(1);
  }
  lastDutyA = dutyA;

  // FREQ knob
  int freqA = digitalRead(ENC_FREQ_A);
  if (lastFreqA == HIGH && freqA == LOW) {
    int freqB = digitalRead(ENC_FREQ_B);

    updateFreqStep();

    if (freqB == LOW) frequency -= freqStep;
    else              frequency += freqStep;

    frequency = constrain(frequency, FREQ_MIN, FREQ_MAX);
    applyPwm();
    updateScreenValues();
    Serial.print("FREQ:"); Serial.println(frequency);
    delay(1);
  }
  lastFreqA = freqA;
}

// ---------------- SETUP ----------------
void setup() {
  Serial.begin(115200);

  pinMode(ENC_DUTY_A, INPUT_PULLUP);
  pinMode(ENC_DUTY_B, INPUT_PULLUP);
  pinMode(ENC_DUTY_SW, INPUT_PULLUP);

  pinMode(ENC_FREQ_A, INPUT_PULLUP);
  pinMode(ENC_FREQ_B, INPUT_PULLUP);
  pinMode(ENC_FREQ_SW, INPUT_PULLUP);

  lastDutyA = digitalRead(ENC_DUTY_A);
  lastFreqA = digitalRead(ENC_FREQ_A);

  // PWM
  initPwm();
  applyPwm();

  // TFT
  tft.init();
  tft.setRotation(1);
  tft.fillScreen(TFT_BLACK);
  drawInterface();
  drawStatusLight();
  updateScreenValues();

  // Temp
  initTempSensor();
  updateTempOnScreen();

  lastHeartbeatTime = millis();
}

// ---------------- LOOP ----------------
void loop() {
  // 1) SERIAL INPUT
  if (Serial.available() > 0) {
    String command = Serial.readStringUntil('\n');
    parseCommand(command);
  }

  // 2) KNOBS
  checkEncoders();

  // 3) SAFETY WATCHDOG
  if (isConnected && (millis() - lastHeartbeatTime > 2000)) {
    dutyCycle = 0;
    applyPwm();
    isConnected = false;

    tft.fillScreen(TFT_RED);
    tft.setTextColor(TFT_WHITE, TFT_RED);
    tft.setTextSize(3);
    tft.setCursor(20, 100);
    tft.print("LINK LOST!");
    tft.setTextSize(2);
    tft.setCursor(40, 150);
    tft.print("Safety Shutdown");

    delay(2000);

    tft.fillScreen(TFT_BLACK);
    drawInterface();
    drawStatusLight();
    updateScreenValues();
    updateTempOnScreen();

    lastHeartbeatTime = millis();
  }

  // 4) TEMP UPDATE (every 500ms)
  if (millis() - lastTempUpdate > 500) {
    pollTemperature();

    if (!tempOk) Serial.println("TEMP:ERR");
    else {
      Serial.print("TEMP:");
      Serial.println(tempC, 2);
    }

    updateTempOnScreen();
    lastTempUpdate = millis();
  }
}
