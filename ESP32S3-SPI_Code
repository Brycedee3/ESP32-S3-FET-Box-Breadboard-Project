#include <SPI.h>
#include <TFT_eSPI.h>

// --- DS18B20 ---
#include <OneWire.h>
#include <DallasTemperature.h>

TFT_eSPI tft = TFT_eSPI();

// ---------------- PINS ----------------
// DUTY ENCODER (Knob 1)
#define ENC_DUTY_A 6
#define ENC_DUTY_B 7
#define ENC_DUTY_SW 4

// FREQ ENCODER (Knob 2)
#define ENC_FREQ_A 15
#define ENC_FREQ_B 16
#define ENC_FREQ_SW 17

// PWM OUTPUT PIN
#define PWM_OUT_PIN 8

// DS18B20 DATA PIN
#define DS18B20_PIN 18

// ---------------- PWM SETTINGS ----------------
// NOTE: High frequency + high resolution can be impossible.
// 10-bit is fine for low kHz; for tens of kHz you may need 8-bit.
const int PWM_RES_BITS = 10;                 // 0..1023
const int PWM_MAX = (1 << PWM_RES_BITS) - 1; // 1023

// ---------------- DS18B20 objects ----------------
OneWire oneWire(DS18B20_PIN);
DallasTemperature sensors(&oneWire);

// ---------------- STATE ----------------
int dutyCycle = 50;        // percent
long frequency = 1000;     // Hz

bool extSource = false;
bool altMode = false;
bool isConnected = false;

unsigned long lastHeartbeatTime = 0;

// Temperature state
float tempC = NAN;
bool tempOk = false;

int lastDutyA = HIGH;
int lastFreqA = HIGH;

unsigned long lastTempUpdate = 0;

// Track what we actually applied
long lastAppliedFreq = -1;
int  lastAppliedDuty = -1;

// ---------------- PWM HELPERS ----------------
static inline uint32_t dutyPercentToCounts(int dPercent) {
  dPercent = constrain(dPercent, 0, 100);
  return (uint32_t)((dPercent * PWM_MAX) / 100);
}

void initPwm() {
  // Attach once (Arduino-ESP32 core v3.x API)
  bool ok = ledcAttach(PWM_OUT_PIN, (uint32_t)constrain(frequency, 1, 100000), PWM_RES_BITS);
  Serial.print("ledcAttach(PWM_OUT_PIN) = ");
  Serial.println(ok ? "OK" : "FAIL");

  // Apply initial duty
  ledcWrite(PWM_OUT_PIN, dutyPercentToCounts(dutyCycle));

  lastAppliedFreq = frequency;
  lastAppliedDuty = dutyCycle;

  // Print the real frequency after attach (some boards quantize)
  uint32_t actual = ledcChangeFrequency(PWM_OUT_PIN, (uint32_t)frequency, PWM_RES_BITS);
  Serial.print("PWM init REQ=");
  Serial.print(frequency);
  Serial.print(" Hz  ACT=");
  Serial.print(actual);
  Serial.println(" Hz");
}

void applyPwm() {
  long fReq = constrain(frequency, 1, 100000);
  int  dReq = constrain(dutyCycle, 0, 100);

  // Only change frequency if it changed
  if (fReq != lastAppliedFreq) {
    uint32_t actual = ledcChangeFrequency(PWM_OUT_PIN, (uint32_t)fReq, PWM_RES_BITS);

    // If actual=0, change failed (usually means not attached)
    Serial.print("PWM freq REQ=");
    Serial.print(fReq);
    Serial.print(" Hz  ACT=");
    Serial.print(actual);
    Serial.println(" Hz");

    lastAppliedFreq = fReq;
  }

  // Only change duty if it changed
  if (dReq != lastAppliedDuty) {
    ledcWrite(PWM_OUT_PIN, dutyPercentToCounts(dReq));
    lastAppliedDuty = dReq;
  }
}

// ---------------- UI DRAWING ----------------
void drawStatusLight() {
  int x = 300, y = 20, radius = 8;
  tft.fillRect(250, 10, 70, 20, TFT_BLUE);

  if (isConnected) {
    tft.fillCircle(x, y, radius, TFT_GREEN);
    tft.setTextColor(TFT_GREEN, TFT_BLUE);
    tft.setTextSize(1);
    tft.setCursor(260, 15);
    tft.print("LINK OK");
  } else {
    tft.fillCircle(x, y, radius, TFT_RED);
    tft.setTextColor(TFT_RED, TFT_BLUE);
    tft.setTextSize(1);
    tft.setCursor(260, 15);
    tft.print("NO LINK");
  }
}

void updateScreenValues() {
  tft.setTextSize(2);
  tft.setTextColor(TFT_GREEN, TFT_BLACK);

  // Duty
  tft.setCursor(80, 60);  tft.print("     ");
  tft.setCursor(80, 60);  tft.print(dutyCycle); tft.print(" %");

  // Freq
  tft.setCursor(80, 100); tft.print("        ");
  tft.setCursor(80, 100); tft.print(frequency); tft.print(" Hz");

  // Source
  tft.setCursor(80, 140); tft.print("        ");
  tft.setCursor(80, 140);
  if (extSource) tft.print("EXTERNAL");
  else           tft.print("INTERNAL");

  // FET2 mode
  tft.setCursor(80, 180); tft.print("          ");
  tft.setCursor(80, 180);
  if (altMode) tft.print("ALTERNATE");
  else         tft.print("COPY (q)");
}

void drawInterface() {
  tft.fillRect(0, 0, 320, 40, TFT_BLUE);
  tft.setTextColor(TFT_WHITE, TFT_BLUE);
  tft.setTextSize(2);
  tft.setCursor(10, 10);
  tft.println("FET BOX CONTROL");

  tft.setTextColor(TFT_WHITE, TFT_BLACK);
  tft.setTextSize(2);

  tft.setCursor(10, 60);   tft.print("Duty:");
  tft.setCursor(10, 100);  tft.print("Freq:");
  tft.setCursor(10, 140);  tft.print("Src:");
  tft.setCursor(10, 180);  tft.print("FET2:");
  tft.setCursor(10, 220);  tft.print("Temp:");
}

// ---------------- TEMPERATURE ----------------
void initTempSensor() {
  sensors.begin();
  sensors.setWaitForConversion(false);
  sensors.requestTemperatures();
}

void pollTemperature() {
  float t = sensors.getTempCByIndex(0);

  if (t == DEVICE_DISCONNECTED_C) {
    tempOk = false;
  } else {
    tempOk = true;
    tempC = t;
  }
  sensors.requestTemperatures();
}

void updateTempOnScreen() {
  tft.setTextSize(2);

  tft.setCursor(80, 220);
  tft.setTextColor(TFT_GREEN, TFT_BLACK);
  tft.print("            ");
  tft.setCursor(80, 220);

  if (!tempOk) {
    tft.setTextColor(TFT_RED, TFT_BLACK);
    tft.print("SENSOR ERR");
    tft.setTextColor(TFT_GREEN, TFT_BLACK);
  } else {
    tft.setTextColor(TFT_GREEN, TFT_BLACK);
    tft.print(tempC, 2);
    tft.print(" C");
  }
}

// ---------------- SERIAL PARSE ----------------
void parseCommand(String cmd) {
  cmd.trim();
  int separator = cmd.indexOf(':');
  if (separator == -1) return;

  String type = cmd.substring(0, separator);
  String val  = cmd.substring(separator + 1);

  if (type == "DUTY") {
    dutyCycle = constrain(val.toInt(), 0, 100);
    applyPwm();
    updateScreenValues();
    Serial.print("DUTY:"); Serial.println(dutyCycle);
  }
  else if (type == "FREQ") {
    frequency = constrain((long)val.toInt(), 1, 100000);
    applyPwm();
    updateScreenValues();
    Serial.print("FREQ:"); Serial.println(frequency);
  }
  else if (type == "SOURCE") {
    extSource = (val == "EXT");
    updateScreenValues();
  }
  else if (type == "FET2") {
    altMode = (val == "ALT");
    updateScreenValues();
  }
  else if (type == "CONN") {
    isConnected = (val == "ON");
    if (isConnected) lastHeartbeatTime = millis();
    drawStatusLight();
  }
  else if (type == "HEARTBEAT") {
    lastHeartbeatTime = millis();
  }
}

// ---------------- ENCODERS ----------------
void checkEncoders() {
  // DUTY knob
  int dutyA = digitalRead(ENC_DUTY_A);
  if (lastDutyA == HIGH && dutyA == LOW) {
    int dutyB = digitalRead(ENC_DUTY_B);
    if (dutyB == LOW) dutyCycle--;
    else              dutyCycle++;

    dutyCycle = constrain(dutyCycle, 0, 100);
    applyPwm();
    updateScreenValues();
    Serial.print("DUTY:"); Serial.println(dutyCycle);
    delay(1);
  }
  lastDutyA = dutyA;

  // FREQ knob
  int freqA = digitalRead(ENC_FREQ_A);
  if (lastFreqA == HIGH && freqA == LOW) {
    int freqB = digitalRead(ENC_FREQ_B);

    // Step size
    const long FREQ_STEP = 100;

    if (freqB == LOW) frequency -= FREQ_STEP;
    else              frequency += FREQ_STEP;

    frequency = constrain(frequency, 1, 100000);
    applyPwm();
    updateScreenValues();
    Serial.print("FREQ:"); Serial.println(frequency);
    delay(1);
  }
  lastFreqA = freqA;
}

// ---------------- SETUP ----------------
void setup() {
  Serial.begin(115200);

  pinMode(ENC_DUTY_A, INPUT_PULLUP);
  pinMode(ENC_DUTY_B, INPUT_PULLUP);
  pinMode(ENC_DUTY_SW, INPUT_PULLUP);

  pinMode(ENC_FREQ_A, INPUT_PULLUP);
  pinMode(ENC_FREQ_B, INPUT_PULLUP);
  pinMode(ENC_FREQ_SW, INPUT_PULLUP);

  lastDutyA = digitalRead(ENC_DUTY_A);
  lastFreqA = digitalRead(ENC_FREQ_A);

  // PWM must be attached before we can change frequency
  initPwm();

  // TFT
  tft.init();
  tft.setRotation(1);
  tft.fillScreen(TFT_BLACK);

  drawInterface();
  drawStatusLight();
  updateScreenValues();

  // Temp
  initTempSensor();
  updateTempOnScreen();

  // Prevent immediate shutdown on boot
  lastHeartbeatTime = millis();
}

// ---------------- LOOP ----------------
void loop() {
  // 1) SERIAL INPUT
  if (Serial.available() > 0) {
    String command = Serial.readStringUntil('\n');
    parseCommand(command);
  }

  // 2) KNOBS
  checkEncoders();

  // 3) SAFETY WATCHDOG
  if (isConnected && (millis() - lastHeartbeatTime > 2000)) {
    // Emergency shutdown
    dutyCycle = 0;
    applyPwm();
    isConnected = false;

    // Red alert
    tft.fillScreen(TFT_RED);
    tft.setTextColor(TFT_WHITE, TFT_RED);
    tft.setTextSize(3);
    tft.setCursor(20, 100);
    tft.print("LINK LOST!");
    tft.setTextSize(2);
    tft.setCursor(40, 150);
    tft.print("Safety Shutdown");

    delay(2000);

    // Restore UI
    tft.fillScreen(TFT_BLACK);
    drawInterface();
    drawStatusLight();
    updateScreenValues();
    updateTempOnScreen();

    lastHeartbeatTime = millis();
  }

  // 4) TEMP UPDATE (every 500ms)
  if (millis() - lastTempUpdate > 500) {
    pollTemperature();

    if (!tempOk) Serial.println("TEMP:ERR");
    else {
      Serial.print("TEMP:");
      Serial.println(tempC, 2);
    }

    updateTempOnScreen();
    lastTempUpdate = millis();
  }
}
