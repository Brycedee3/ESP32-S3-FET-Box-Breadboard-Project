#include <SPI.h>
#include <TFT_eSPI.h>
#include <OneWire.h>
#include <DallasTemperature.h>

TFT_eSPI tft = TFT_eSPI();

// ===================== PINS =====================
// DUTY ENCODER (Knob 1)
#define ENC_DUTY_A   6
#define ENC_DUTY_B   7
#define ENC_DUTY_SW  4

// FREQ ENCODER (Knob 2)
#define ENC_FREQ_A   15
#define ENC_FREQ_B   16
#define ENC_FREQ_SW  17

// PWM OUTPUT PIN (ESP32-S3: pick a "normal" GPIO; avoid USB pins, boot strapping pins)
#define PWM_OUT_PIN  8

// DS18B20 DATA PIN
#define DS18B20_PIN  18

// ===================== LIMITS =====================
const long FREQ_MIN = 1;
const long FREQ_MAX = 350000;      // target max = 350 kHz

// High-frequency band start: from here up, we force a stable configuration.
const long HIGH_BAND_START = 200000;

// High-band snap step: reduces “frequency flipping” due to LEDC quantization
const long HIGH_SNAP_STEP = 5000;  // 5 kHz steps (stable)

// “Settle time” so we don't spam retunes while you're spinning the knob
const unsigned long FREQ_SETTLE_MS = 25;

// ===================== TEMP SENSOR =====================
OneWire oneWire(DS18B20_PIN);
DallasTemperature sensors(&oneWire);

// ===================== UI/STATE =====================
int  dutyCycle = 50;          // percent (user intent)
long freqUser  = 1000;        // user intent (Hz)
long freqShown = 1000;        // what we display (locked to actual)
uint32_t freqAct = 0;         // actual LEDC frequency (Hz)

bool extSource   = false;
bool altMode     = false;
bool isConnected = false;

unsigned long lastHeartbeatTime = 0;

float tempC = NAN;
bool  tempOk = false;

int lastDutyA = HIGH;
int lastFreqA = HIGH;

unsigned long lastTempUpdate = 0;

// ===================== PWM INTERNAL =====================
int currentResBits = 10;
int lastAppliedResBits = -1;
int lastAppliedDuty = -1;

long pendingFreq = 1000;
bool freqDirty = true;
unsigned long lastFreqEditMs = 0;

// ---- Helper: counts, snapping, etc. ----
static inline uint32_t maxCounts(int bits) {
  if (bits <= 0) return 1;
  if (bits >= 31) return 0x7FFFFFFF;
  return (1u << bits) - 1u;
}

static inline uint32_t dutyPercentToCounts(int percent, int bits) {
  percent = constrain(percent, 0, 100);
  uint32_t m = maxCounts(bits);
  return (uint32_t)((uint64_t)percent * (uint64_t)m / 100ull);
}

// In high band, we *must* reduce resolution to make 200–350k stable.
// This mapping is conservative for ESP32-S3.
int chooseResBits(long f) {
  if (f >= HIGH_BAND_START) return 1;     // 1-bit (0/50/100% duty) = most stable
  if (f >= 120000)          return 4;
  if (f >= 30000)           return 8;
  return 10;
}

// Snap frequency to realizable increments to prevent “flip-flop”
long snapFreq(long f) {
  f = constrain(f, FREQ_MIN, FREQ_MAX);

  if (f < 20000)           return f;                  // 1 Hz
  if (f < 100000)          return (f / 100) * 100;    // 100 Hz
  if (f < HIGH_BAND_START) return (f / 1000) * 1000;  // 1 kHz
  return (f / HIGH_SNAP_STEP) * HIGH_SNAP_STEP;       // 5 kHz in high band
}

// In 1-bit, duty only effectively supports 0/50/100 (anything else jitters/rounds)
int snapDuty1Bit(int d) {
  d = constrain(d, 0, 100);
  if (d < 25) return 0;
  if (d < 75) return 50;
  return 100;
}

// Attach (or re-attach) PWM with chosen resolution
void pwmAttachIfNeeded(long f) {
  int wantRes = chooseResBits(f);

  if (wantRes != currentResBits || lastAppliedResBits < 0) {
    currentResBits = wantRes;

    bool ok = ledcAttach(PWM_OUT_PIN, (uint32_t)f, currentResBits);
    Serial.print("PWM attach PIN=");
    Serial.print(PWM_OUT_PIN);
    Serial.print(" RES=");
    Serial.print(currentResBits);
    Serial.print(" -> ");
    Serial.println(ok ? "OK" : "FAIL");

    lastAppliedResBits = currentResBits;
    lastAppliedDuty = -1; // force duty rewrite after attach
  }
}

// Apply duty using current resolution
void pwmApplyDuty() {
  int d = dutyCycle;

  if (currentResBits == 1) {
    d = snapDuty1Bit(d);
    dutyCycle = d; // reflect reality on UI
  }

  if (d != lastAppliedDuty) {
    ledcWrite(PWM_OUT_PIN, dutyPercentToCounts(d, currentResBits));
    lastAppliedDuty = d;
  }
}

// Apply frequency (once) and lock UI to ACT result
void pwmApplyFrequencyNow(long f) {
  f = snapFreq(f);

  pwmAttachIfNeeded(f);

  uint32_t act = ledcChangeFrequency(PWM_OUT_PIN, (uint32_t)f, currentResBits);

  if (act != 0) {
    freqAct = act;

    // Lock everything to actual so it doesn't “fight” LEDC quantization
    freqUser  = (long)freqAct;
    pendingFreq = (long)freqAct;
    freqShown = (long)freqAct;

    Serial.print("PWM FREQ REQ=");
    Serial.print(f);
    Serial.print(" ACT=");
    Serial.print(freqAct);
    Serial.print(" RES=");
    Serial.println(currentResBits);
  } else {
    Serial.println("PWM freq change failed (ACT=0)");
  }

  pwmApplyDuty();
}

void pwmInit() {
  pendingFreq = snapFreq(freqUser);
  pwmAttachIfNeeded(pendingFreq);

  // Set initial duty and frequency
  pwmApplyDuty();
  pwmApplyFrequencyNow(pendingFreq);
}

// ===================== UI =====================
void drawStatusLight() {
  int x = 300, y = 20, radius = 8;
  tft.fillRect(250, 10, 70, 20, TFT_BLUE);

  if (isConnected) {
    tft.fillCircle(x, y, radius, TFT_GREEN);
    tft.setTextColor(TFT_GREEN, TFT_BLUE);
    tft.setTextSize(1);
    tft.setCursor(260, 15);
    tft.print("LINK OK");
  } else {
    tft.fillCircle(x, y, radius, TFT_RED);
    tft.setTextColor(TFT_RED, TFT_BLUE);
    tft.setTextSize(1);
    tft.setCursor(260, 15);
    tft.print("NO LINK");
  }
}

void drawInterface() {
  tft.fillRect(0, 0, 320, 40, TFT_BLUE);
  tft.setTextColor(TFT_WHITE, TFT_BLUE);
  tft.setTextSize(2);
  tft.setCursor(10, 10);
  tft.println("FET BOX CONTROL");

  tft.setTextColor(TFT_WHITE, TFT_BLACK);
  tft.setTextSize(2);

  tft.setCursor(10, 60);   tft.print("Duty:");
  tft.setCursor(10, 100);  tft.print("Freq:");
  tft.setCursor(10, 140);  tft.print("Src:");
  tft.setCursor(10, 180);  tft.print("FET2:");
  tft.setCursor(10, 220);  tft.print("Temp:");
}

void updateScreenValues() {
  tft.setTextSize(2);
  tft.setTextColor(TFT_GREEN, TFT_BLACK);

  // Duty
  tft.setCursor(80, 60);  tft.print("        ");
  tft.setCursor(80, 60);  tft.print(dutyCycle); tft.print(" %");

  // Frequency (ACT-locked)
  tft.setCursor(80, 100); tft.print("              ");
  tft.setCursor(80, 100); tft.print(freqShown); tft.print(" Hz");

  // Source
  tft.setCursor(80, 140); tft.print("        ");
  tft.setCursor(80, 140);
  if (extSource) tft.print("EXTERNAL");
  else           tft.print("INTERNAL");

  // FET2
  tft.setCursor(80, 180); tft.print("          ");
  tft.setCursor(80, 180);
  if (altMode) tft.print("ALTERNATE");
  else         tft.print("COPY (q)");
}

// ===================== TEMP =====================
void initTempSensor() {
  sensors.begin();
  sensors.setWaitForConversion(false);
  sensors.requestTemperatures();
}

void pollTemperature() {
  float t = sensors.getTempCByIndex(0);
  if (t == DEVICE_DISCONNECTED_C) tempOk = false;
  else { tempOk = true; tempC = t; }
  sensors.requestTemperatures();
}

void updateTempOnScreen() {
  tft.setTextSize(2);
  tft.setCursor(80, 220);

  tft.setTextColor(TFT_GREEN, TFT_BLACK);
  tft.print("            ");
  tft.setCursor(80, 220);

  if (!tempOk) {
    tft.setTextColor(TFT_RED, TFT_BLACK);
    tft.print("SENSOR ERR");
    tft.setTextColor(TFT_GREEN, TFT_BLACK);
  } else {
    tft.print(tempC, 2);
    tft.print(" C");
  }
}

// ===================== SERIAL =====================
void parseCommand(String cmd) {
  cmd.trim();
  int sep = cmd.indexOf(':');
  if (sep == -1) return;

  String type = cmd.substring(0, sep);
  String val  = cmd.substring(sep + 1);

  if (type == "DUTY") {
    dutyCycle = constrain(val.toInt(), 0, 100);
    pwmApplyDuty();
    updateScreenValues();
    Serial.print("DUTY:"); Serial.println(dutyCycle);
  }
  else if (type == "FREQ") {
    freqUser = constrain((long)val.toInt(), FREQ_MIN, FREQ_MAX);
    pendingFreq = snapFreq(freqUser);
    freqDirty = true;
    lastFreqEditMs = millis();

    // show pending immediately
    freqShown = pendingFreq;
    updateScreenValues();

    Serial.print("FREQ_REQ:"); Serial.println(pendingFreq);
  }
  else if (type == "SOURCE") {
    extSource = (val == "EXT");
    updateScreenValues();
  }
  else if (type == "FET2") {
    altMode = (val == "ALT");
    updateScreenValues();
  }
  else if (type == "CONN") {
    isConnected = (val == "ON");
    if (isConnected) lastHeartbeatTime = millis();
    drawStatusLight();
  }
  else if (type == "HEARTBEAT") {
    lastHeartbeatTime = millis();
  }
}

// ===================== ENCODERS =====================
long freqStepFor(long f) {
  f = constrain(f, FREQ_MIN, FREQ_MAX);
  if      (f < 20000)           return 100;
  else if (f < 100000)          return 1000;
  else if (f < HIGH_BAND_START) return 2000;
  else                          return HIGH_SNAP_STEP; // 5 kHz steps in high band
}

void checkEncoders() {
  // DUTY
  int dutyA = digitalRead(ENC_DUTY_A);
  if (lastDutyA == HIGH && dutyA == LOW) {
    int dutyB = digitalRead(ENC_DUTY_B);
    dutyCycle += (dutyB == LOW) ? -1 : +1;
    dutyCycle = constrain(dutyCycle, 0, 100);

    pwmApplyDuty();
    updateScreenValues();
    Serial.print("DUTY:"); Serial.println(dutyCycle);
  }
  lastDutyA = dutyA;

  // FREQ
  int freqA = digitalRead(ENC_FREQ_A);
  if (lastFreqA == HIGH && freqA == LOW) {
    int freqB = digitalRead(ENC_FREQ_B);
    long step = freqStepFor(pendingFreq);

    pendingFreq += (freqB == LOW) ? -step : +step;
    pendingFreq = constrain(pendingFreq, FREQ_MIN, FREQ_MAX);
    pendingFreq = snapFreq(pendingFreq);

    freqDirty = true;
    lastFreqEditMs = millis();

    // show pending while turning
    freqShown = pendingFreq;
    updateScreenValues();
  }
  lastFreqA = freqA;
}

// ===================== SETUP =====================
void setup() {
  Serial.begin(115200);

  pinMode(ENC_DUTY_A, INPUT_PULLUP);
  pinMode(ENC_DUTY_B, INPUT_PULLUP);
  pinMode(ENC_DUTY_SW, INPUT_PULLUP);

  pinMode(ENC_FREQ_A, INPUT_PULLUP);
  pinMode(ENC_FREQ_B, INPUT_PULLUP);
  pinMode(ENC_FREQ_SW, INPUT_PULLUP);

  lastDutyA = digitalRead(ENC_DUTY_A);
  lastFreqA = digitalRead(ENC_FREQ_A);

  // PWM
  pwmInit();

  // TFT
  tft.init();
  tft.setRotation(1);
  tft.fillScreen(TFT_BLACK);
  drawInterface();
  drawStatusLight();
  updateScreenValues();

  // TEMP
  initTempSensor();
  updateTempOnScreen();

  lastHeartbeatTime = millis();
}

// ===================== LOOP =====================
void loop() {
  // Serial
  if (Serial.available() > 0) {
    String command = Serial.readStringUntil('\n');
    parseCommand(command);
  }

  // Encoders
  checkEncoders();

  // Apply frequency after settle time
  if (freqDirty && (millis() - lastFreqEditMs >= FREQ_SETTLE_MS)) {
    freqDirty = false;
    pwmApplyFrequencyNow(pendingFreq);
    updateScreenValues();
  }

  // Safety watchdog
  if (isConnected && (millis() - lastHeartbeatTime > 2000)) {
    dutyCycle = 0;
    pwmApplyDuty();
    isConnected = false;

    tft.fillScreen(TFT_RED);
    tft.setTextColor(TFT_WHITE, TFT_RED);
    tft.setTextSize(3);
    tft.setCursor(20, 100);
    tft.print("LINK LOST!");
    tft.setTextSize(2);
    tft.setCursor(40, 150);
    tft.print("Safety Shutdown");

    delay(2000);

    tft.fillScreen(TFT_BLACK);
    drawInterface();
    drawStatusLight();
    updateScreenValues();
    updateTempOnScreen();

    lastHeartbeatTime = millis();
  }

  // Temp update
  if (millis() - lastTempUpdate > 500) {
    pollTemperature();

    if (!tempOk) Serial.println("TEMP:ERR");
    else {
      Serial.print("TEMP:");
      Serial.println(tempC, 2);
    }

    updateTempOnScreen();
    lastTempUpdate = millis();
  }
}
